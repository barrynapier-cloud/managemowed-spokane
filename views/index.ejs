<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#6b9a00">
<title><%= loc.pageTitle %></title>
<meta name="description" content="<%= loc.metaDescription %>">
<link rel="canonical" href="https://<%= host %>/">

<!-- Favicons -->
<link rel="icon" type="image/png" href="/assets/logo-official.png">
<link rel="apple-touch-icon" href="/assets/logo-official.png">

<!-- Open Graph -->
<meta property="og:title" content="<%= loc.ogTitle %>">
<meta property="og:description" content="<%= loc.ogDescription %>">
<meta property="og:type" content="website">
<meta property="og:url" content="https://<%= host %>/">
<meta property="og:image" content="https://<%= host %><%= loc.ogImage || loc.heroImage %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= loc.ogTitle %>">
<meta name="twitter:description" content="<%= loc.ogDescription %>">
<meta name="twitter:image" content="https://<%= host %><%= loc.ogImage || loc.heroImage %>">

<!-- Preload hero image (LCP) -->
<link rel="preload" as="image" href="<%= loc.heroImage %>">

<!-- Fonts -->
<link rel="preconnect" href="https://api.fontshare.com">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=general-sans@300,400,500,600,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Symbols+Outlined">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

<!-- GSAP (defer so it doesn't block first paint) -->
<script defer src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js"></script>

<link rel="stylesheet" href="/style.css?v=20260502c">

<!-- Local Business structured data for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "ManageMowed <%= loc.city %>",
  "description": "<%= loc.metaDescription %>",
  "url": "https://<%= host %>/",
  "telephone": "<%= loc.contact.phone %>",
  "email": "<%= loc.contact.email %>",
  "image": "https://<%= host %><%= loc.ogImage || loc.heroImage %>",
  "priceRange": "$$",
  "address": { "@type": "PostalAddress", "addressLocality": "<%= loc.city %>", "addressRegion": "<%= loc.state %>", "addressCountry": "US" },
  "areaServed": <%- JSON.stringify((loc.areaServed && loc.areaServed.length) ? loc.areaServed : [loc.city]) %>
}
</script>
</head>
<body data-location="<%= loc.key %>" data-contact-phone="<%= loc.contact.phone %>">

<!-- NAVIGATION -->
<nav id="navbar" class="navbar">
  <div class="nav-inner">
    <a href="#" class="logo-link">
      <img src="/assets/logo-official.png?v=20260423c" alt="ManageMowed" class="nav-logo-img" width="459" height="136">
    </a>

    <div class="nav-links">
      <a href="#services">Services</a>
      <a href="#about">About</a>
      <a href="#areas">Service Areas</a>
      <a href="#news">In the Press</a>
    </div>

    <div class="nav-actions">
      <a href="tel:<%= loc.contact.phoneRaw %>" class="nav-phone">
        <span class="material-symbols-outlined">call</span>
        <%= loc.contact.phone %>
      </a>
      <a href="#contact" class="btn-primary btn-sm">Request a Quote
        <span class="material-symbols-outlined btn-icon">arrow_forward</span>
      </a>
    </div>

    <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileMenu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <a href="#services">Services</a>
    <a href="#about">About</a>
    <a href="#areas">Service Areas</a>
    <a href="#news">In the Press</a>
    <a href="tel:<%= loc.contact.phoneRaw %>" class="mobile-phone"><span class="material-symbols-outlined">call</span> <%= loc.contact.phone %></a>
    <a href="#contact" class="btn-primary" style="text-align:center;margin-top:0.5rem;">Request a Quote</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero">
  <div class="hero-bg">
    <img src="<%= loc.heroImage %>" alt="<%= loc.heroImageAlt %>" class="hero-img" loading="eager" fetchpriority="high" width="2752" height="1536">
    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <h1 class="hero-title">
      <span class="line line-eyebrow">ManageMowed</span>
      <span class="line line-1"><%= loc.heroHeadlinePrefix %></span>
      <span class="line line-2">Commercial</span>
      <span class="line line-3 accent">Landscape Partner.</span>
    </h1>

    <p class="hero-description">
      <%= loc.heroSubtitle %>
    </p>

    <div class="hero-ctas">
      <a href="#contact" class="btn-primary btn-lg">
        Request a Quote
        <span class="material-symbols-outlined btn-icon">arrow_forward</span>
      </a>
      <a href="tel:<%= loc.contact.phoneRaw %>" class="btn-outline btn-lg">
        Call <%= loc.contact.phone %>
        <span class="material-symbols-outlined btn-icon">call</span>
      </a>
    </div>

    <div class="hero-trust">
      <div class="trust-item">
        <span class="material-symbols-outlined">group</span>
        <%= loc.trustItemAccountManagers %>
      </div>
      <div class="trust-item">
        <span class="material-symbols-outlined">calendar_month</span>
        365-Day Maintenance Service
      </div>
      <div class="trust-item">
        <span class="material-symbols-outlined">verified</span>
        Licensed &amp; Insured
      </div>
    </div>
  </div>

  <a href="#stats" class="scroll-indicator" aria-label="Scroll to learn more">
    <span class="scroll-text">Discover</span>
    <span class="material-symbols-outlined scroll-arrow">expand_more</span>
  </a>
</section>

<!-- TRUST BANNER — National Brand Clients -->
<section class="trust-banner" id="stats">
  <div class="container">
    <p class="trust-banner-label">Trusted by national brands and property managers across the country</p>
    <div class="trust-logos">
      <div class="trust-logo-item">Chevron</div>
      <div class="trust-logo-item">Chase</div>
      <div class="trust-logo-item">Safeway</div>
      <div class="trust-logo-item">Pizza Hut</div>
      <div class="trust-logo-item">Jack in the Box</div>
      <div class="trust-logo-item">Public Storage</div>
      <div class="trust-logo-item">MOD Pizza</div>
    </div>
  </div>
</section>

<!-- WEATHER / RELIABILITY SECTION -->
<section class="snow-break">
  <img src="<%= loc.weatherImage %>" alt="<%= loc.weatherImageAlt %>" loading="lazy" decoding="async" width="2752" height="1536">
  <div class="snow-overlay"></div>
  <div class="snow-content">
    <h2><%= loc.weatherHeadline %><br><span class="accent"><%= loc.weatherSubhead %></span></h2>
    <p><%= loc.weatherBody %></p>
  </div>
</section>

<!-- ANIMATED STATS COUNTER -->
<section class="stats-counter" id="metrics">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-number" data-target="24">0</div>
        <div class="stat-label">Locations Nationwide</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-target="980" data-suffix="K+">0</div>
        <div class="stat-label">Sq Ft Managed Monthly</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-target="92" data-suffix="%">0</div>
        <div class="stat-label">Client Retention Rate</div>
      </div>
      <div class="stat-item">
        <div class="stat-number" data-target="365">0</div>
        <div class="stat-label">Days of Service Per Year</div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT / DIFFERENTIATOR -->
<section class="about-section" id="about">
  <div class="about-image-col">
    <img src="<%= loc.aboutImage %>" alt="<%= loc.aboutImageAlt %>" loading="lazy" decoding="async" width="1672" height="941" style="object-position: <%= loc.aboutImageObjectPosition || 'center center' %>;">
    <div class="about-image-overlay"></div>
    <div class="about-image-border"></div>
  </div>
  <div class="about-content-col">
    <div class="about-inner">
      <span class="section-label"><span class="material-symbols-outlined" style="font-size:1rem;">verified</span> The ManageMowed Difference</span>
      <h2 class="section-title">We Manage Your Property,<br><span class="accent">Regardless of the Weather.</span></h2>
      <p class="about-description"><%= loc.aboutDescription %></p>

      <div class="about-features">
        <div class="about-feature">
          <div class="feature-dot"></div>
          <div>
            <strong>Local Account Managers</strong>
            <span>Single point of contact for every property need</span>
          </div>
        </div>
        <div class="about-feature">
          <div class="feature-dot"></div>
          <div>
            <strong>Proactive Communication</strong>
            <span>Monthly quality reports and enhancement recommendations</span>
          </div>
        </div>
        <div class="about-feature">
          <div class="feature-dot"></div>
          <div>
            <strong>National Network, Local Crews</strong>
            <span><%= loc.aboutBootsLine %></span>
          </div>
        </div>
      </div>

      <a href="#contact" class="btn-outline" style="margin-top:2rem;">Request a Quote <span class="material-symbols-outlined btn-icon">arrow_forward</span></a>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="services" id="services">
  <div class="container">
    <div class="section-header">
      <span class="section-label"><span class="label-line"></span> Our Expertise</span>
      <h2 class="section-title">Comprehensive Grounds Management</h2>
      <p class="section-subtitle">From weekly maintenance to seasonal enhancements and storm response, we handle every aspect of your commercial property's exterior.</p>
    </div>

    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon-bg">
          <span class="material-symbols-outlined">landscape</span>
        </div>
        <div class="service-number">01</div>
        <h3>Enhancements</h3>
        <p>Curb-appeal upgrades and property improvements that make a lasting first impression. From color installations to hardscape work, we handle the projects that elevate your property.</p>
        <ul class="service-features">
          <li>Mulch &amp; bed refreshes</li>
          <li>Seasonal color installations</li>
          <li>Sod replacement &amp; turf repair</li>
          <li>Tree &amp; shrub planting</li>
          <li>Hardscape edging &amp; rock work</li>
          <li>Xeriscape install &amp; maintenance</li>
        </ul>
        <a href="#contact" class="service-cta">Request a Quote <span class="material-symbols-outlined">arrow_forward</span></a>
      </div>

      <div class="service-card featured">
        <div class="featured-badge">Most Requested</div>
        <div class="service-icon-bg">
          <span class="material-symbols-outlined">yard</span>
        </div>
        <div class="service-number">02</div>
        <h3>Maintenance</h3>
        <p>Scheduled mowing, precision edging, pruning, bed maintenance, and leaf removal. Your property stays pristine year-round with dedicated crews and a single point of contact.</p>
        <ul class="service-features">
          <li>Weekly mowing &amp; edging</li>
          <li>Shrub &amp; tree pruning</li>
          <li>Irrigation management</li>
          <li>Dedicated account manager</li>
          <li>Monthly quality inspections</li>
        </ul>
        <a href="#contact" class="service-cta">Request a Quote <span class="material-symbols-outlined">arrow_forward</span></a>
      </div>

      <div class="service-card">
        <div class="service-icon-bg">
          <span class="material-symbols-outlined">ac_unit</span>
        </div>
        <div class="service-number">03</div>
        <h3>Seasonal Services</h3>
        <p><%= loc.seasonalServicesBody %></p>
        <ul class="service-features">
          <% (loc.seasonalServiceItems || []).forEach(function(item) { %>
          <li><%- item %></li>
          <% }); %>
        </ul>
        <a href="#contact" class="service-cta">Request a Quote <span class="material-symbols-outlined">arrow_forward</span></a>
      </div>
    </div>
  </div>
</section>

<!-- BEFORE / AFTER SLIDER -->
<section class="before-after-section" id="transformation">
  <div class="container">
    <div class="section-header center">
      <span class="section-label"><span class="label-line"></span> The Transformation</span>
      <h2 class="section-title">See the ManageMowed Difference</h2>
      <p class="section-subtitle">Drag the slider to reveal how ManageMowed transforms neglected commercial properties into pristine, well-maintained landscapes.</p>
    </div>
    <div class="ba-slider-wrapper">
      <div class="ba-slider" id="baSlider">
        <div class="ba-image ba-after">
          <img src="<%= loc.sliderAfter || '/assets/after-property.png' %>" alt="Property after ManageMowed service" loading="lazy" decoding="async" width="1920" height="1080">
          <span class="ba-label ba-label-after"><span class="material-symbols-outlined">check_circle</span> After</span>
        </div>
        <div class="ba-image ba-before">
          <img src="<%= loc.sliderBefore || '/assets/before-property.png' %>" alt="Property before ManageMowed service" loading="lazy" decoding="async" width="1920" height="1080">
          <span class="ba-label ba-label-before"><span class="material-symbols-outlined">warning</span> Before</span>
        </div>
        <div class="ba-handle" id="baHandle">
          <div class="ba-handle-line"></div>
          <div class="ba-handle-circle">
            <span class="material-symbols-outlined">drag_indicator</span>
          </div>
          <div class="ba-handle-line"></div>
        </div>
      </div>
      <p class="ba-hint"><span class="material-symbols-outlined">swipe</span> Drag to compare</p>
    </div>
  </div>
</section>

<!-- "YOUR PROPERTY DESERVES BETTER" CTA BANNER -->
<section class="deserves-cta">
  <div class="deserves-bg">
    <img src="<%= loc.deservesCtaImage %>" alt="<%= loc.deservesCtaImageAlt %>" loading="lazy" decoding="async" width="2752" height="1536">
    <div class="deserves-overlay"></div>
  </div>
  <div class="deserves-content">
    <h2>Your Property Deserves <span class="accent-bright">Better.</span></h2>
    <p><%= loc.deservesCtaBody %></p>
    <a href="#contact" class="btn-primary btn-lg">Request a Quote <span class="material-symbols-outlined btn-icon">arrow_forward</span></a>
  </div>
</section>

<!-- SERVICE AREAS -->
<section class="service-areas" id="areas">
  <div class="areas-bg-image">
    <img src="<%= loc.areasBgImage %>" alt="<%= loc.areasBgImageAlt %>" loading="lazy" decoding="async" width="2752" height="1536">
    <div class="areas-bg-overlay"></div>
  </div>
  <div class="container">
    <div class="section-header center">
      <span class="section-label"><span class="label-line"></span> Coverage</span>
      <h2 class="section-title"><%= loc.areasHeadline %></h2>
      <p class="section-subtitle"><%= loc.areasSubtitle %></p>
    </div>

    <div class="areas-grid">
      <% loc.areaGroups.forEach(function(group) { %>
        <div class="area-group">
          <h3><span class="material-symbols-outlined"><%= group.icon %></span> <%= group.name %></h3>
          <ul>
            <% group.items.forEach(function(item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- CONTACT FORM -->
<section class="contact" id="contact">
  <div class="container">
    <div class="contact-wrapper">
      <div class="contact-info">
        <div class="contact-info-inner">
          <h2>Request a Quote</h2>
          <p>Complete the form and a ManageMowed landscape consultant will reach out within 24 hours with a custom quote for your property.</p>

          <div class="contact-details">
            <div class="contact-detail">
              <div class="contact-icon">
                <span class="material-symbols-outlined">person</span>
              </div>
              <div>
                <span class="contact-label">Your <%= loc.contact.title %></span>
                <span class="contact-value"><%= loc.contact.name %></span>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-icon">
                <span class="material-symbols-outlined">call</span>
              </div>
              <div>
                <span class="contact-label">Call Direct</span>
                <a href="tel:<%= loc.contact.phoneRaw %>" class="contact-value"><%= loc.contact.phone %></a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-icon">
                <span class="material-symbols-outlined">mail</span>
              </div>
              <div>
                <span class="contact-label">Email</span>
                <a href="mailto:<%= loc.contact.email %>" class="contact-value"><%= loc.contact.email %></a>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-icon">
                <span class="material-symbols-outlined">language</span>
              </div>
              <div>
                <span class="contact-label">Website</span>
                <a href="<%= loc.contact.websiteUrl %>" target="_blank" rel="noopener noreferrer" class="contact-value"><%= loc.contact.website %></a>
              </div>
            </div>
          </div>

          <div class="contact-social">
            <a href="https://www.linkedin.com/company/managemowed/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="contact-form-col">
        <form class="contact-form" id="leadForm" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="fullName">Full Name *</label>
              <input type="text" id="fullName" name="fullName" placeholder="John Smith" required>
            </div>
            <div class="form-group">
              <label for="email">Email *</label>
              <input type="text" id="email" name="email" placeholder="john@company.com" required inputmode="email" autocomplete="email">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone</label>
              <input type="text" id="phone" name="phone" placeholder="<%= loc.phonePlaceholder || '(555) 555-0123' %>" inputmode="tel" autocomplete="tel">
            </div>
            <div class="form-group">
              <label for="company">Company / Property</label>
              <input type="text" id="company" name="company" placeholder="Acme Business Park">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="propertyType">Property Type</label>
              <select id="propertyType" name="propertyType">
                <option value="">Select...</option>
                <option>Office Complex</option>
                <option>Retail Center</option>
                <option>Apartment Community</option>
                <option>Industrial Park</option>
                <option>Medical / Hospitality</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-group">
              <label for="service">Service Interest</label>
              <select id="service" name="service">
                <option value="">Select...</option>
                <option>Full Service Maintenance</option>
                <option>Landscape Enhancement</option>
                <option>Snow &amp; Ice Management</option>
                <option>Irrigation</option>
                <option>One-Time Cleanup</option>
              </select>
            </div>
          </div>

          <div class="form-group full">
            <label for="details">Property Details</label>
            <textarea id="details" name="details" rows="4" placeholder="Tell us about your property — location, acreage, current challenges, or specific needs..."></textarea>
          </div>

          <button type="submit" class="btn-primary btn-lg btn-full">
            <span>Request a Quote</span>
            <span class="material-symbols-outlined btn-icon">send</span>
          </button>

          <p class="form-disclaimer">
            <span class="material-symbols-outlined" style="font-size:0.875rem;">lock</span>
            Your information is secure. We'll respond within 24 hours.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- "DON'T SEE YOUR AREA" CTA STRIP -->
<section class="dontsee-cta">
  <div class="container">
    <div class="dontsee-inner">
      <div class="dontsee-copy">
        <h3>Don't See Your Area?</h3>
        <p>We may still be able to help. Reach out and we'll let you know.</p>
      </div>
      <a href="#contact" class="btn-primary btn-lg">Request a Quote <span class="material-symbols-outlined btn-icon">arrow_forward</span></a>
    </div>
  </div>
</section>

<!-- NEWS & PR -->
<section class="news-section" id="news">
  <div class="container">
    <div class="section-header center">
      <span class="section-label"><span class="label-line"></span> In The News</span>
      <h2 class="section-title">ManageMowed in the Press</h2>
      <p class="section-subtitle">See what leading industry publications are saying about our approach to commercial landscape management.</p>
    </div>
    <div class="news-grid-dynamic">
      <a href="https://www.fmlink.com/bring-consistency-to-your-landscape-maintenance-services-with-oversight-by-managemowed/" target="_blank" rel="noopener noreferrer" class="news-card-featured">
        <div class="news-card-featured-accent"></div>
        <div class="news-featured-inner">
          <span class="news-pub-badge">FMLink</span>
          <h3>Bring Consistency to Your Landscape Maintenance Services with Oversight by ManageMowed</h3>
          <p>"Property managers are expected to deliver consistency across their portfolios, but the industry hasn't given them the tools or structure to do that easily. That's the gap we set out to solve."</p>
          <span class="news-quote-attr">— Peter Roberts, Co-Founder</span>
          <span class="news-link">Read Full Article <span class="material-symbols-outlined">arrow_outward</span></span>
        </div>
      </a>
      <div class="news-side-stack">
        <a href="https://www.prnewswire.com/news-releases/managemowed-brings-consistency-to-business-properties-in-landscaping-302695248.html" target="_blank" rel="noopener noreferrer" class="news-card-compact">
          <span class="news-pub-badge">PR Newswire</span>
          <h3>ManageMowed Brings Consistency to Business Properties in Landscaping</h3>
          <p>ManageMowed eliminates vendor chaos with a structured, end-to-end landscape management model built for commercial properties.</p>
          <span class="news-link">Read Article <span class="material-symbols-outlined">arrow_outward</span></span>
        </a>
        <a href="https://app.prnewswire.com/vr-ui/release/wire?suppAcct=2634762&storyNumber=CL93885&storyDate=20260224" target="_blank" rel="noopener noreferrer" class="news-card-compact">
          <span class="news-pub-badge">PR Newswire</span>
          <h3>ManageMowed Expands Structured Landscape Management Nationwide</h3>
          <p>With 700,000+ independent operators in a $180B industry, ManageMowed is bringing standardized accountability coast to coast.</p>
          <span class="news-link">Read Article <span class="material-symbols-outlined">arrow_outward</span></span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="faq-section" id="faq">
  <div class="container">
    <div class="section-header center">
      <span class="section-label"><span class="label-line"></span> Common Questions</span>
      <h2 class="section-title">Frequently Asked Questions</h2>
    </div>
    <div class="faq-grid">
      <div class="faq-item">
        <button class="faq-question" id="faq-q-1" aria-expanded="false" aria-controls="faq-a-1">
          <span>How quickly can you start servicing my property?</span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-1" role="region" aria-labelledby="faq-q-1">
          <p>Just give us a call — we can typically have a crew at your property within 24 hours, and in many cases the same day for urgent needs like storm cleanup or safety hazards.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question" id="faq-q-2" aria-expanded="false" aria-controls="faq-a-2">
          <span>Do you require long-term contracts?</span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-2" role="region" aria-labelledby="faq-q-2">
          <p>No. We earn your business every month. Our 92% client retention rate speaks for itself — clients stay because they love the results, not because they're locked in. We offer flexible month-to-month and annual agreements.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question" id="faq-q-3" aria-expanded="false" aria-controls="faq-a-3">
          <span>What's included in the free site assessment?</span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-3" role="region" aria-labelledby="faq-q-3">
          <p>Your dedicated Account Manager will conduct a comprehensive walk-through evaluating turf health, irrigation systems, tree and shrub conditions, hardscape areas, safety concerns, and curb appeal. You'll receive a detailed report with photos, recommendations, and a custom maintenance plan tailored to your budget.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question" id="faq-q-4" aria-expanded="false" aria-controls="faq-a-4">
          <span><%= loc.faqWeatherQuestion %></span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-4" role="region" aria-labelledby="faq-q-4">
          <p><%= loc.faqWeatherAnswer %></p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question" id="faq-q-5" aria-expanded="false" aria-controls="faq-a-5">
          <span>Can you manage multiple properties across different locations?</span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-5" role="region" aria-labelledby="faq-q-5">
          <p>Absolutely — that's one of our core strengths. With 24 locations nationwide and a centralized management structure, we provide consistent quality across all your properties with a single point of contact and unified reporting.</p>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-question" id="faq-q-6" aria-expanded="false" aria-controls="faq-a-6">
          <span>What types of commercial properties do you service?</span>
          <span class="material-symbols-outlined faq-icon">expand_more</span>
        </button>
        <div class="faq-answer" id="faq-a-6" role="region" aria-labelledby="faq-q-6">
          <p>We service office complexes, retail centers, industrial parks, apartment communities, property management portfolios, medical facilities, hospitality properties, and more. If it's commercial, we manage it.</p>
        </div>
      </div>
    </div>
  </div>
</section>

