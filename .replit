run = "npx serve . -l 3000 --no-clipboard --single"
entrypoint = "index.html"
modules = ["python-3.11", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["node", "server.js"]
deploymentTarget = "gce"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[userenv]

[userenv.shared]
LOCATION_NAME = "Spokane Area"
LEAD_NOTIFICATION_EMAIL = "Cort.f@managemowed.com,james.j@managemowed.com,peter.r@managemowed.com,barrynapier@gmail.com"
RESEND_FROM_EMAIL = "ManageMowed Spokane <leads@managemowedspokane.com>"
